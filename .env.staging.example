APP_ENV=staging
APP_HOST=127.0.0.1
APP_PORT=8100
APP_PUBLIC_ORIGINS=http://127.0.0.1:5173
DEPLOYMENT_ID=libtv-agent-staging
POSTGRES_DB=libtv_agent_staging
POSTGRES_USER=libtv_agent_staging
POSTGRES_PASSWORD=replace-with-staging-secret
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://libtv_agent_staging:replace-with-staging-secret@localhost:5433/libtv_agent_staging
MINIO_ROOT_USER=libtv_agent_staging
MINIO_ROOT_PASSWORD=replace-with-staging-secret
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=libtv_agent_staging
MINIO_SECRET_KEY=replace-with-staging-secret
MINIO_BUCKET=libtv-agent
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_DATA_DIR=F:/libtv-agent/staging/minio
OBJECT_STORE_MODE=minio
OBJECT_STORE_PREFIX=staging
SESSION_SECRET=replace-with-staging-session-secret
SHARED_AUTHENTICATION_ENABLED=true
SESSION_COOKIE_SECURE=true
LIBTV_WORKSPACE_ID=replace-with-staging-workspace-id
LIBTV_PROJECT_UUID=replace-with-staging-project-uuid
LIBTV_ADAPTER_MODE=fake
LIBTV_EXECUTION_MODE=dry-run
LIBTV_CONFIG_DIR=var/runtime/libtv
LIBTV_AUTH_CHECK_SECONDS=60
KLING_CLI_ENABLED=false
KLING_CLI_EXECUTABLE=kling
KLING_CLI_DEFAULT_MODEL=
KLING_STORYBOARD_FALLBACK_MODE=disabled
KLING_ENABLE_PAID_INTEGRATION_TEST=false
KLING_PROVIDER_BACKEND=api
KLING_API_ENABLED=false
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_API_MODEL=kling-3.0-omni
KLING_API_DURATION=10
KLING_API_ASPECT_RATIO=9:16
KLING_API_RESOLUTION=1080p
KLING_API_AUDIO=off
KLING_API_MULTI_SHOT=true
KLING_API_REQUEST_TIMEOUT_SECONDS=60
KLING_API_TASK_TIMEOUT_SECONDS=1800
KLING_API_MAX_SUBMIT_CONCURRENCY=1
KLING_API_MAX_POLL_CONCURRENCY=4
KLING_API_POLL_INTERVAL_SECONDS=20
KLING_API_MAX_POLL_INTERVAL_SECONDS=60
KLING_API_ENABLE_PAID_INTEGRATION_TEST=false
WAVESPEED_ENABLED=false
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_PROVIDER_NAME=wavespeed
WAVESPEED_REQUEST_TIMEOUT_SECONDS=60
WAVESPEED_MAX_SUBMIT_CONCURRENCY=1
WAVESPEED_MAX_POLL_CONCURRENCY=4
WAVESPEED_GET_MAX_RETRIES=3
WAVESPEED_GET_RETRY_BASE_SECONDS=2
WAVESPEED_GET_RETRY_MAX_SECONDS=30
WAVESPEED_ADMIN_CONFIG_FILE=var/runtime/wavespeed-config.json
PAID_GENERATION_ENABLED=false
PAID_GENERATION_CONFIRMATION=
AI_ADAPTER_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ANALYSIS_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_ANALYSIS_FALLBACK_REASONING_EFFORT=low
OPENAI_ANALYSIS_VERBOSITY=low
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=4000
OPENAI_ANALYSIS_FALLBACK_MAX_OUTPUT_TOKENS=6000
OPENAI_ANALYSIS_TIMEOUT_SECONDS=180
OPENAI_ANALYSIS_TIMEOUT_BASE_IMAGE_COUNT=4
OPENAI_ANALYSIS_TIMEOUT_PER_EXTRA_IMAGE_SECONDS=45
OPENAI_ANALYSIS_TIMEOUT_MAX_SECONDS=600
ANALYSIS_STALE_AFTER_SECONDS=660
ANALYSIS_SHUTDOWN_GRACE_SECONDS=15
GENERATION_SAME_PROJECT=1
GENERATION_PER_USER=1
GENERATION_GLOBAL=1
UNKNOWN_USER_WINDOW_SECONDS=1800
UNKNOWN_USER_DISTINCT_TASK_THRESHOLD=2
UNKNOWN_PROVIDER_WINDOW_SECONDS=600
UNKNOWN_PROVIDER_DISTINCT_TASK_THRESHOLD=5
UNKNOWN_PROVIDER_DISTINCT_USER_THRESHOLD=3
UNKNOWN_PROVIDER_MIN_ATTEMPTS=6
UNKNOWN_PROVIDER_RATE_THRESHOLD=0.5
PAID_SUBMISSIONS_PAUSED=true
AUTO_CONFIRM_LEVELS=PASS
