APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_ORIGINS=http://localhost:5173
DEPLOYMENT_ID=libtv-agent-development
SHARED_AUTHENTICATION_ENABLED=false

POSTGRES_DB=libtv_agent_dev
POSTGRES_USER=libtv_agent_dev
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://libtv_agent_dev:replace-with-local-secret@localhost:5432/libtv_agent_dev
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=libtv_agent_dev
MINIO_ROOT_PASSWORD=replace-with-local-secret
MINIO_ACCESS_KEY=libtv_agent_dev
MINIO_SECRET_KEY=replace-with-local-secret
MINIO_SECURE=false
MINIO_BUCKET=libtv-agent
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=F:/libtv-agent/development/minio
OBJECT_STORE_PREFIX=development
OBJECT_STORE_MODE=minio

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ANALYSIS_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_ANALYSIS_FALLBACK_REASONING_EFFORT=low
OPENAI_ANALYSIS_VERBOSITY=low
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=4000
OPENAI_ANALYSIS_FALLBACK_MAX_OUTPUT_TOKENS=6000
OPENAI_ANALYSIS_TIMEOUT_SECONDS=180
OPENAI_ANALYSIS_TIMEOUT_BASE_IMAGE_COUNT=4
OPENAI_ANALYSIS_TIMEOUT_PER_EXTRA_IMAGE_SECONDS=45
OPENAI_ANALYSIS_TIMEOUT_MAX_SECONDS=600
ANALYSIS_STALE_AFTER_SECONDS=660
ANALYSIS_RECOVERY_POLL_SECONDS=30
ANALYSIS_SHUTDOWN_GRACE_SECONDS=15
AI_ADAPTER_MODE=fake
AI_REPLAY_FIXTURE=backend/tests/fixtures/ai/analysis.json

LIBTV_ADAPTER_MODE=fake
LIBTV_EXECUTION_MODE=dry-run
PAID_GENERATION_ENABLED=false
PAID_GENERATION_CONFIRMATION=
LIBTV_EXECUTABLE=libtv
LIBTV_CONFIG_DIR=var/runtime/libtv
LIBTV_AUTH_CHECK_SECONDS=60
LIBTV_DOWNLOAD_HELPER=C:/Users/runner/.codex/skills/libtv-cli/scripts/download-libtv-video.ps1
LIBTV_REPLAY_FIXTURE_DIR=backend/tests/fixtures/libtv
LIBTV_WORKSPACE_ID=replace-with-development-workspace-id
LIBTV_PROJECT_UUID=replace-with-development-project-uuid
FAKE_LIBTV_SCENARIO=success

# New production work is fixed to the official API.
KLING_PROVIDER_BACKEND=api
# CLI is recovery-only for historical attempts that already have a remote task ID.
KLING_CLI_ENABLED=false
KLING_CLI_EXECUTABLE=kling
KLING_CLI_PROVIDER_NAME=kling_official_cli
KLING_CLI_DEFAULT_MODEL=
KLING_CLI_DEFAULT_DURATION=10
KLING_CLI_DEFAULT_ASPECT_RATIO=9:16
KLING_CLI_COMMAND_TIMEOUT_MS=30000
KLING_CLI_QUERY_TIMEOUT_MS=30000
KLING_CLI_DOWNLOAD_TIMEOUT_MS=300000
KLING_CLI_GLOBAL_QPS=4
KLING_CLI_MAX_SUBMIT_CONCURRENCY=1
KLING_CLI_MAX_QUERY_CONCURRENCY=4
KLING_CLI_POLL_INTERVAL_SECONDS=20
KLING_CLI_MAX_POLL_INTERVAL_SECONDS=60
KLING_STORYBOARD_FALLBACK_MODE=disabled
KLING_CLI_CAPABILITY_CACHE_SECONDS=3600
KLING_ENABLE_PAID_INTEGRATION_TEST=false
# Never commit a real key. API 2.0 uses one server-side Bearer API Key.
KLING_API_ENABLED=false
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_API_PROVIDER_NAME=kling_official_api
KLING_API_MODEL=kling-3.0-omni
KLING_API_DURATION=10
KLING_API_ASPECT_RATIO=9:16
KLING_API_RESOLUTION=1080p
KLING_API_AUDIO=off
KLING_API_MULTI_SHOT=true
KLING_API_CALLBACK_URL=
KLING_API_REQUEST_TIMEOUT_SECONDS=60
KLING_API_TASK_TIMEOUT_SECONDS=1800
KLING_API_DOWNLOAD_TIMEOUT_SECONDS=300
KLING_API_MAX_SUBMIT_CONCURRENCY=1
KLING_API_MAX_POLL_CONCURRENCY=4
KLING_API_POLL_INTERVAL_SECONDS=20
KLING_API_MAX_POLL_INTERVAL_SECONDS=60
KLING_API_MAX_RETRIES=3
KLING_API_ENABLE_PAID_INTEGRATION_TEST=false
MAX_INPUT_IMAGE_BYTES=20971520

ARTIFACT_ROOT=var/artifacts
RUNNER_ROOT=var/runner
DAILY_USER_POINTS_LIMIT=5000
GENERATION_ESTIMATED_POINTS=120
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000099

DOWNLOAD_CONCURRENCY=4
TECHNICAL_VALIDATION_CONCURRENCY=2
OUTPUT_RETENTION_DAYS=7
SESSION_SECRET=change-me-before-shared-use
SESSION_COOKIE_SECURE=true

GENERATION_SAME_PROJECT=1
GENERATION_PER_USER=1
GENERATION_GLOBAL=1
UNKNOWN_USER_WINDOW_SECONDS=1800
UNKNOWN_USER_DISTINCT_TASK_THRESHOLD=2
UNKNOWN_PROVIDER_WINDOW_SECONDS=600
UNKNOWN_PROVIDER_DISTINCT_TASK_THRESHOLD=5
UNKNOWN_PROVIDER_DISTINCT_USER_THRESHOLD=3
UNKNOWN_PROVIDER_MIN_ATTEMPTS=6
UNKNOWN_PROVIDER_RATE_THRESHOLD=0.5
PREPARED_QUEUE_LOW_WATERMARK=12
PREPARED_QUEUE_HIGH_WATERMARK=24
GLOBAL_PAUSED=false
PAID_SUBMISSIONS_PAUSED=true
AUTO_CONFIRM_LEVELS=PASS
