{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/ai-analysis-2.2.json",
  "title": "AI Analysis Result 2.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "garmentFacts", "storyboardFacts", "consistencyObservations", "riskFlags", "stablePlan", "dynamicPlan", "userRequirementNormalized", "modelVersion"],
  "properties": {
    "schemaVersion": {"const": "2.2"},
    "garmentFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "mainColor", "secondaryColor", "print", "logo", "text", "fit", "frontSellingPoints", "backSellingPoints", "unknownFields"],
      "properties": {
        "category": {"type": "string"}, "mainColor": {"type": "string"}, "secondaryColor": {"type": "string"},
        "print": {"type": "string"}, "logo": {"type": "string"}, "text": {"type": "string"}, "fit": {"type": "string"},
        "frontSellingPoints": {"type": "array", "items": {"type": "string"}},
        "backSellingPoints": {"type": "array", "items": {"type": "string"}},
        "unknownFields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "storyboardFacts": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/storyboardFact"}},
    "consistencyObservations": {"$ref": "#/$defs/consistencyObservations"},
    "riskFlags": {"type": "array", "items": {"type": "string", "enum": ["TEXT_OR_LOGO_KEY_SELLING_POINT", "GARMENT_PARTIALLY_OCCLUDED", "STORYBOARD_GARMENT_CONFLICT", "STORYBOARD_IDENTITY_CONFLICT", "MULTIPLE_PEOPLE", "BACK_VIEW_REQUIRED", "LOW_DETAIL_REFERENCE", "LARGE_POSE_CHANGE", "SCENE_DISCONTINUITY"]}},
    "stablePlan": {"$ref": "#/$defs/variantPlan"}, "dynamicPlan": {"$ref": "#/$defs/variantPlan"},
    "userRequirementNormalized": {"type": "string"}, "modelVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "storyboardFact": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "order", "scene", "framing", "pose", "actionCandidates", "interactionObjects", "productVisibility", "shotFunction"],
      "properties": {"assetId": {"type": "string"}, "order": {"type": "integer", "minimum": 1, "maximum": 7}, "scene": {"type": "string"}, "framing": {"type": "string"}, "pose": {"type": "string"}, "actionCandidates": {"type": "array", "items": {"type": "string"}}, "interactionObjects": {"type": "array", "items": {"type": "string"}}, "productVisibility": {"type": "string"}, "shotFunction": {"type": "string"}}
    },
    "consistencyObservations": {"type": "object", "additionalProperties": false, "required": ["reasonCodes", "summary", "unknownFields", "evidenceAssetIds"], "properties": {"reasonCodes": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string"}, "unknownFields": {"type": "array", "items": {"type": "string"}}, "evidenceAssetIds": {"type": "array", "items": {"type": "string"}}}},
    "shot": {"type": "object", "additionalProperties": false, "required": ["referenceAssetIds", "durationWeight", "entryState", "action", "exitState", "camera", "productDisplay", "shotFunction"], "properties": {"referenceAssetIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "durationWeight": {"type": "number", "exclusiveMinimum": 0}, "entryState": {"type": "string"}, "action": {"type": "string"}, "exitState": {"type": "string"}, "camera": {"type": "string"}, "productDisplay": {"type": "string"}, "shotFunction": {"type": "string"}}},
    "variantPlan": {"type": "object", "additionalProperties": false, "required": ["continuityStrategy", "shots"], "properties": {"continuityStrategy": {"const": "state_continuity"}, "shots": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/shot"}}}}
  }
}
