{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/quality-failure-taxonomy-1.0.json",
  "title": "Quality Failure Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomyVersion", "failures"],
  "properties": {
    "taxonomyVersion": {"const": "1.0"},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "family", "severity", "description"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
          "family": {"type": "string", "enum": ["INPUT", "MEDIA", "CONTENT", "CONSISTENCY", "EVIDENCE", "SYSTEM"]},
          "severity": {"type": "string", "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "retryable": {"type": "boolean"},
          "requiresHumanReview": {"type": "boolean"}
        }
      }
    }
  }
}
