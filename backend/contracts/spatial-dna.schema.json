{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "libtv://contracts/spatial-dna/v1",
  "title": "Spatial DNA",
  "description": "Planning-only spatial observations. This contract does not describe depth-model output or provider execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "preflightStatus",
    "providerSubmissionAllowed",
    "referenceId",
    "coordinateSystem",
    "depthReferences",
    "cameraRelationships",
    "occlusionRelations"
  ],
  "properties": {
    "schemaVersion": { "const": "spatial-dna.v1" },
    "mode": { "const": "OFFLINE_SYNTHETIC_ONLY" },
    "preflightStatus": { "const": "PREFLIGHT_REQUIRED" },
    "providerSubmissionAllowed": { "const": false },
    "referenceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "coordinateSystem": { "enum": ["IMAGE_NORMALIZED_2D", "SCREEN_SPACE_2D"] },
    "depthReferences": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "depth-reference-contract.schema.json" }
    },
    "cameraRelationships": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "camera-relationship.schema.json" }
    },
    "occlusionRelations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frontEntityId", "backEntityId", "relation"],
        "properties": {
          "frontEntityId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "backEntityId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "relation": { "const": "FRONT_OCCLUDES_BACK" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
