APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_ORIGINS=http://localhost:5173
DEPLOYMENT_ID=libtv-agent-development
SHARED_AUTHENTICATION_ENABLED=false
POSTGRES_DB=libtv_agent_dev
POSTGRES_USER=libtv_agent_dev
POSTGRES_PASSWORD=replace-with-development-secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://libtv_agent_dev:replace-with-development-secret@localhost:5432/libtv_agent_dev
MINIO_ROOT_USER=libtv_agent_dev
MINIO_ROOT_PASSWORD=replace-with-development-secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=libtv_agent_dev
MINIO_SECRET_KEY=replace-with-development-secret
MINIO_BUCKET=libtv-agent
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=F:/libtv-agent/development/minio
OBJECT_STORE_MODE=minio
OBJECT_STORE_PREFIX=development
SESSION_SECRET=replace-with-development-session-secret
SESSION_COOKIE_SECURE=true
LIBTV_WORKSPACE_ID=replace-with-development-workspace-id
LIBTV_PROJECT_UUID=replace-with-development-project-uuid
LIBTV_ADAPTER_MODE=fake
LIBTV_EXECUTION_MODE=dry-run
LIBTV_CONFIG_DIR=var/runtime/libtv
LIBTV_AUTH_CHECK_SECONDS=60
KLING_CLI_ENABLED=false
KLING_CLI_EXECUTABLE=kling
KLING_CLI_DEFAULT_MODEL=
KLING_STORYBOARD_FALLBACK_MODE=disabled
KLING_ENABLE_PAID_INTEGRATION_TEST=false
PAID_GENERATION_ENABLED=false
PAID_GENERATION_CONFIRMATION=
AI_ADAPTER_MODE=fake
OPENAI_ANALYSIS_TIMEOUT_SECONDS=180
OPENAI_ANALYSIS_TIMEOUT_BASE_IMAGE_COUNT=4
OPENAI_ANALYSIS_TIMEOUT_PER_EXTRA_IMAGE_SECONDS=45
OPENAI_ANALYSIS_TIMEOUT_MAX_SECONDS=600
ANALYSIS_STALE_AFTER_SECONDS=660
ANALYSIS_RECOVERY_POLL_SECONDS=30
ANALYSIS_SHUTDOWN_GRACE_SECONDS=15
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ANALYSIS_FALLBACK_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
GENERATION_SAME_PROJECT=1
GENERATION_PER_USER=1
GENERATION_GLOBAL=1
PAID_SUBMISSIONS_PAUSED=true
AUTO_CONFIRM_LEVELS=PASS
