OPENAI_ANALYSIS_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_ANALYSIS_FALLBACK_REASONING_EFFORT=low
OPENAI_ANALYSIS_VERBOSITY=low
