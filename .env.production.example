APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8200
APP_PUBLIC_ORIGINS=http://127.0.0.1:5173
DEPLOYMENT_ID=libtv-agent-production
POSTGRES_DB=libtv_agent_production
POSTGRES_USER=libtv_agent_production
POSTGRES_PASSWORD=replace-with-production-secret
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://libtv_agent_production:replace-with-production-secret@localhost:5434/libtv_agent_production
MINIO_ROOT_USER=libtv_agent_production
MINIO_ROOT_PASSWORD=replace-with-production-secret
MINIO_ENDPOINT=localhost:9200
MINIO_ACCESS_KEY=libtv_agent_production
MINIO_SECRET_KEY=replace-with-production-secret
MINIO_BUCKET=libtv-agent
MINIO_PORT=9200
MINIO_CONSOLE_PORT=9201
MINIO_DATA_DIR=F:/libtv-agent/production/minio
OBJECT_STORE_MODE=minio
OBJECT_STORE_PREFIX=production
SESSION_SECRET=replace-with-production-session-secret
SHARED_AUTHENTICATION_ENABLED=true
SESSION_COOKIE_SECURE=true
LIBTV_WORKSPACE_ID=replace-with-production-workspace-id
LIBTV_PROJECT_UUID=replace-with-production-project-uuid
LIBTV_ADAPTER_MODE=fake
LIBTV_EXECUTION_MODE=dry-run
DIRECTOR_WORKFLOW_MODE=offline_demo
LIBTV_CONFIG_DIR=var/runtime/libtv
LIBTV_AUTH_CHECK_SECONDS=60
KLING_CLI_ENABLED=false
KLING_CLI_EXECUTABLE=kling
KLING_CLI_DEFAULT_MODEL=
KLING_STORYBOARD_FALLBACK_MODE=disabled
KLING_ENABLE_PAID_INTEGRATION_TEST=false
KLING_PROVIDER_BACKEND=api
KLING_API_ENABLED=false
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_API_MODEL=kling-3.0-omni
KLING_API_DURATION=10
KLING_API_ASPECT_RATIO=9:16
KLING_API_RESOLUTION=1080p
KLING_API_AUDIO=off
KLING_API_MULTI_SHOT=true
KLING_API_REQUEST_TIMEOUT_SECONDS=60
KLING_API_TASK_TIMEOUT_SECONDS=1800
KLING_API_MAX_SUBMIT_CONCURRENCY=1
KLING_API_MAX_POLL_CONCURRENCY=4
KLING_API_POLL_INTERVAL_SECONDS=20
KLING_API_MAX_POLL_INTERVAL_SECONDS=60
KLING_API_ENABLE_PAID_INTEGRATION_TEST=false
WAVESPEED_ENABLED=false
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_PROVIDER_NAME=wavespeed
WAVESPEED_REQUEST_TIMEOUT_SECONDS=60
WAVESPEED_MAX_SUBMIT_CONCURRENCY=50
WAVESPEED_MAX_POLL_CONCURRENCY=4
WAVESPEED_GET_MAX_RETRIES=3
WAVESPEED_GET_RETRY_BASE_SECONDS=2
WAVESPEED_GET_RETRY_MAX_SECONDS=30
WAVESPEED_VIDEO_PROVIDER_NAME=wavespeed_video
WAVESPEED_VIDEO_MODEL=kwaivgi/kling-video-o3-pro/reference-to-video
WAVESPEED_VIDEO_DURATION=10
WAVESPEED_VIDEO_ASPECT_RATIO=9:16
WAVESPEED_VIDEO_SOUND=false
WAVESPEED_VIDEO_TASK_TIMEOUT_SECONDS=1800
WAVESPEED_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=300
WAVESPEED_VIDEO_POLL_INTERVAL_SECONDS=10
WAVESPEED_VIDEO_MAX_POLL_INTERVAL_SECONDS=30
WAVESPEED_ADMIN_CONFIG_FILE=var/runtime/wavespeed-config.json
BACH_ENABLED=false
BACH_ACCESS_KEY=
BACH_SECRET_KEY=
BACH_API_BASE_URL=https://api-gen-na.bach.art/api/vdr
BACH_PROVIDER_NAME=bach
BACH_MODEL=bach-1.0
BACH_RESOLUTION=720p
BACH_DURATION=6
BACH_ASPECT_RATIO=9:16
BACH_GENERATE_AUDIO=false
BACH_REQUEST_TIMEOUT_SECONDS=60
BACH_TASK_TIMEOUT_SECONDS=1800
BACH_DOWNLOAD_TIMEOUT_SECONDS=300
BACH_MAX_SUBMIT_CONCURRENCY=1
BACH_MAX_POLL_CONCURRENCY=4
BACH_POLL_INTERVAL_SECONDS=10
BACH_MAX_POLL_INTERVAL_SECONDS=60
BACH_ADMIN_CONFIG_FILE=var/runtime/bach-config.json
PAID_GENERATION_ENABLED=false
PAID_GENERATION_CONFIRMATION=
AI_ADAPTER_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=
