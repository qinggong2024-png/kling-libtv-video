{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/video-replication-research.v1.json",
  "title": "Video Replication Research v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "qualificationScope",
    "project",
    "referenceVideo",
    "motionDna",
    "videoBlueprint",
    "evidence",
    "providerSubmissionAllowed",
    "productionBridgeStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "video-replication-research.v1" },
    "status": { "const": "PREFLIGHT_REQUIRED" },
    "qualificationScope": { "const": "OFFLINE_SYNTHETIC_ONLY" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "projectRevision": { "type": "integer", "minimum": 0 },
        "intelligenceSnapshot": { "type": "object" }
      }
    },
    "referenceVideo": { "$ref": "#/$defs/referenceVideoMetadata" },
    "motionDna": { "$ref": "#/$defs/motionDna" },
    "videoBlueprint": { "$ref": "#/$defs/videoBlueprint" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/researchEvidence" }
    },
    "providerSubmissionAllowed": { "const": false },
    "productionBridgeStatus": { "const": "PREFLIGHT_REQUIRED" }
  },
  "$defs": {
    "researchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["OBSERVATION", "USER_NOTE", "SOURCE_METADATA"] },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string" }
      }
    },
    "referenceVideoMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "title", "retrievedAt", "rightsNote", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["USER_PROVIDED", "PUBLIC_REFERENCE", "INTERNAL_LIBRARY"] },
        "title": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "creator": { "type": "string" },
        "platform": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "hasAudio": { "type": "boolean" },
        "language": { "type": "string" },
        "rightsNote": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string" },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "motionDnaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "confidence", "rationale"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "motionDnaSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startSeconds",
        "endSeconds",
        "subjectAction",
        "subjectState",
        "cameraMovement",
        "cameraIntensity",
        "framing",
        "pacing",
        "productFocus",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "subjectAction": { "type": "string", "minLength": 1 },
        "subjectState": { "type": "string", "minLength": 1 },
        "cameraMovement": { "$ref": "#/$defs/cameraMovement" },
        "cameraIntensity": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "framing": { "type": "string", "minLength": 1 },
        "pacing": { "enum": ["SLOW", "MODERATE", "FAST"] },
        "productFocus": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/motionDnaEvidence" } }
      }
    },
    "motionDna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "summary", "segments", "continuityRules", "forbiddenInferences", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/motionDnaSegment" } },
        "continuityRules": { "type": "array", "items": { "type": "string" } },
        "forbiddenInferences": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cameraMovement": {
      "enum": ["STATIC", "PAN", "TILT", "DOLLY", "TRACK", "HANDHELD", "ZOOM", "ROTATION"]
    },
    "cameraPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movement", "framing", "lensIntent", "stability"],
      "properties": {
        "movement": { "$ref": "#/$defs/cameraMovement" },
        "framing": { "type": "string", "minLength": 1 },
        "lensIntent": { "type": "string", "minLength": 1 },
        "stability": { "enum": ["LOCKED", "CONTROLLED_HANDHELD", "HANDHELD"] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "videoBlueprintShot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "startSeconds",
        "endSeconds",
        "purpose",
        "subjectAction",
        "camera",
        "productDisplay",
        "continuityConstraints",
        "sourceSegmentIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": { "type": "string", "minLength": 1 },
        "subjectAction": { "type": "string", "minLength": 1 },
        "camera": { "$ref": "#/$defs/cameraPlan" },
        "productDisplay": { "type": "string", "minLength": 1 },
        "continuityConstraints": { "type": "array", "items": { "type": "string" } },
        "sourceSegmentIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "videoBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "source", "durationSeconds", "aspectRatio", "audioIntent", "shots", "invariants", "excludedElements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source": { "enum": ["USER_PROVIDED", "PLANNING_DERIVED"] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "aspectRatio": { "type": "string", "minLength": 1 },
        "audioIntent": { "enum": ["NONE", "REFERENCE_ONLY", "UNSPECIFIED"] },
        "shots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/videoBlueprintShot" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "excludedElements": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
